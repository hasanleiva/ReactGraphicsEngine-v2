{
  "name": "canva-editor",
  "private": false,
  "version": "1.0.72",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "build-lib": "vite build && echo 'export type { EditorConfig } from \"./types/editor\";' >> dist/src/index.d.ts",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "homepage": "#",
  "repository": {
    "type": "git",
    "url": "#"
  },
  "license": "MIT License",
  "keywords": [
    "canva clone",
    "canva editor",
    "canvajs",
    "canva.js",
    "react canvajs",
    "graphic design tool",
    "online design software",
    "react design app",
    "canva alternative",
    "responsive design",
    "drag-and-drop design",
    "collaboration in design",
    "user-friendly design tool",
    "seo-friendly design",
    "social media graphics tool",
    "javascript design tool",
    "canva-like editor",
    "canva-inspired design",
    "canva-style graphics",
    "canva alternative for react"
  ],
  "main": "./dist/canva-editor.umd.js",
  "module": "./dist/canva-editor.es.js",
  "types": "./dist/src/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/canva-editor.es.js",
      "require": "./dist/canva-editor.umd.js"
    },
    "./index.module.css": {
      "import": "./dist/index.module.css",
      "require": "./dist/index.module.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@emotion/babel-plugin": "^11.11.0",
    "@emotion/css": "^11.11.2",
    "@emotion/is-prop-valid": "^1.3.1",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@floating-ui/dom": "^1.5.3",
    "@types/prosemirror-commands": "^1.3.0",
    "@types/prosemirror-gapcursor": "^1.3.0",
    "@types/prosemirror-history": "^1.3.0",
    "@types/prosemirror-inputrules": "^1.2.0",
    "@types/prosemirror-model": "^1.17.0",
    "@types/prosemirror-state": "^1.4.0",
    "@types/prosemirror-transform": "^1.5.0",
    "@types/prosemirror-view": "^1.24.0",
    "@vitejs/plugin-react": "^4.2.0",
    "axios": "^1.5.1",
    "bcryptjs": "^3.0.3",
    "classnames": "^2.3.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "framer-motion": "^10.16.9",
    "immer": "^10.0.3",
    "jspdf": "^2.5.1",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "modern-screenshot": "^4.4.38",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "prop-types": "^15.8.1",
