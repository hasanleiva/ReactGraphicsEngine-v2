    "react-dom": "^18.2.0",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "^7.18.1",
    "react-singleton-hook": "^4.0.1",
    "styled-components": "^6.1.0",
    "svg-path-round-corners": "^0.1.5",
    "typescript": "~5.7.2",
    "unsplash-js": "^7.0.19",
    "uuid": "^9.0.1",
    "vite": "^6.3.3",
    "vite-plugin-dts": "~4.5.0",
